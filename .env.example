# ─── nota. environment variables ─────────────────────────────────────────────
# Copy to .env and fill in your values.
# Lines marked [REQUIRED] will cause the app to fail without them.
# Lines marked [LIVE] activate a real integration (mock is used without them).

# ── Database [REQUIRED] ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/nota?sslmode=require
# Get a free Postgres from https://neon.tech or https://railway.app

# ── Auth [REQUIRED in production] ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── App URL (used for QR codes and MIA webhook callback) ─────────────────────
APP_URL=https://your-app.up.railway.app
# Leave as http://localhost:3000 for local dev

# ── iiko Cloud API [LIVE] ─────────────────────────────────────────────────────
# From iiko back-office → Settings → Integrations → Cloud API
IIKO_API_LOGIN=
# Regional API endpoint (confirm with iiko support for Moldova):
IIKO_BASE_URL=https://api-ru.iiko.services
# Your Organization UUID (visible in iiko back-office URL or API response):
IIKO_ORG_ID=
# UUID of your "External / nota." payment type (create in iiko back-office):
IIKO_EXTERNAL_PAYMENT_TYPE_ID=

# ── maib MIA QR API [LIVE — our own testing only] ─────────────────────────────
# Docs: https://docs.maibmerchants.md/mia-qr-api
# Real restaurants configure their OWN maib credentials per-restaurant through the onboarding
# wizard (dashboard → Plăți) — those are stored encrypted in the restaurants table, not here.
# These env vars are only a fallback for directly testing server/mia.js's functions without a
# restaurant context (e.g. from a script). They have no effect on any restaurant's actual
# payment flow — a restaurant without maib_status='active' always runs in mock mode regardless
# of what's set here.
#
# Get sandbox credentials by emailing ecom@maib.md with your IDNO, business name, and
# integration details. Production credentials come from maib after merchant onboarding.
#
# Leave all of these unset to stay in mock mode (default — current demo behavior, unchanged).

# sandbox | production — anything else (or unset) falls back to mock, even if the vars below are set
MAIB_MIA_ENV=

# "Client ID" / "Client Secret" from maib onboarding — used to obtain a Bearer token
# (POST /v2/auth/token). Cached and refreshed automatically before it expires.
MAIB_CLIENT_ID=
MAIB_CLIENT_SECRET=

# Separate "Signature Key" from maib onboarding — used only to verify the callback
# notification signature at POST /api/payment/webhook. Without it, callbacks are always
# rejected (fail closed) even if MAIB_MIA_ENV is set.
MAIB_SIGNATURE_KEY=

# ── Menu photo storage ─────────────────────────────────────────────────────────
# IMAGE_STORAGE=db (default, no setup needed) stores uploaded menu photos as bytes in Postgres
# (Neon persists fine — Railway's own app filesystem does not, which is why this isn't just a
# folder on disk). Fine for a restaurant's menu photo count.
#
# IMAGE_STORAGE=s3 uploads to any S3-compatible bucket instead (AWS S3, Cloudflare R2, Backblaze
# B2, MinIO) and stores only the public URL — recommended once you have real photo volume.
IMAGE_STORAGE=db

# Only used when IMAGE_STORAGE=s3:
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# ── Dev / admin access ─────────────────────────────────────────────────────────
# Gates /api/dev/* (seeding, table tokens, sandbox payment simulation) and /api/admin/*
# (internal restaurant list — onboarding stage, maib status — for us to see who's stuck).
# Leave unset locally if you're fine authenticating dev endpoints with a restaurant JWT instead;
# required in any environment where you want the admin view.
DEV_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
